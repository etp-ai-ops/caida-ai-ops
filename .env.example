# Required. Generate a unique random value of at least 32 characters.
MCP_MASTER_KEY=<REQUIRED>

# Required: configure exactly one database mode. Use DATABASE_URL alone, or
# leave it empty and set every DB_* variable below for a dedicated read-only role.
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Optional settings. Empty values use the documented defaults.
MCP_HOST=
MCP_PORT=
DB_POOL_MAX=
QUERY_TIMEOUT_MS=
OUTPUT_DIR=
LOG_LEVEL=

# --- Live Ark measurement -------------------------------------------------
# The Ark mux is a unix socket present only on an Ark host. Both settings are
# needed for the Ark half; the ITDK half works without them.
#
# Numeric group id owning /run/ark/mux. Assigned per host, so read it there:
#   getent group ark-mux | cut -d: -f3
ARK_MUX_GID=
# Path to the socket on the host (override only if it is not the default).
ARK_MUX_SOCKET=/run/ark/mux

# --- ITDK MCP server (caida-itdk-mcp) --------------------------------------
# For running the ITDK tools through an MCP client. Copy this file to `.env`
# in the folder you open with the client and fill in the three below.
#
# Keep them here, not in `.mcp.json`: that is a JSON config file which tends to
# end up in version control, and `.env` is gitignored. Real environment
# variables still win over this file, so containers and CI are unaffected.
#
#   MCP_MASTER_KEY   32+ visible ASCII characters
#   DATABASE_URL     postgresql://USER:PASSWORD@db.nids.caida.org:5432/caida-itdk
#   OUTPUT_DIR       absolute path; ITDK tools write CSVs there and return the
#                    path, so the client must be able to read it too
